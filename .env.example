# Copy to .env and fill in. Use your server's LAN IP (not "localhost") for the service URLs.

# --- Required ---
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=
# APP_PASSWORD=choose-a-password   # default is obiwan if left unset; change it

# --- Strongly recommended (without these some columns are blank or less accurate) ---
TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_API_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
SEERR_URL=http://192.168.1.10:5055
SEERR_API_KEY=

# --- Safety ---
# Nothing is deleted while this is true. Flip to false only once the reports look right.
DRY_RUN=true

# --- Optional ---
# PLEX_LIBRARIES=Movies,TV Shows     # limit to specific libraries (default: all movie/show libraries)
# WATCHED_PERCENT=85                 # episode counts as watched at this % complete
# MAX_DELETE_BATCH=200
# VERIFY_TLS=true

# --- Behind a Cloudflare tunnel (HTTPS) ---
# COOKIE_SECURE=true
# TRUST_PROXY=true
